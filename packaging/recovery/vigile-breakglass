#!/usr/bin/env bash
# Vigile break-glass recovery (ISS-051)
#
# PURPOSE: recover a machine where Vigile has locked out the user.
# This is the LAST RESORT — it disables Vigile's policy enforcement
# temporarily (audit-only mode) so you can fix the problem.
#
# SECURITY PROPERTIES (docs/RECOVERY_AND_BREAK_GLASS.md):
# - LOCAL ONLY: must be run from a physical console or declared-critical SSH.
# - TIME-LIMITED: enforcement resumes automatically after 4 hours.
# - AUDITED: the action is logged locally AND reported to the server.
# - LOUD: the server administrator is alerted on the next sync.
# - NO BACKDOOR: there is no universal secret — this is a local action.

set -euo pipefail

MAX_TTL_SECS=$((4 * 3600))
VIGILE_RULES_DIR="/etc/fapolicyd/rules.d/vigile"
VIGILE_LOG="/var/log/vigile-breakglass.log"

usage() {
    echo "Usage: sudo vigile-breakglass --reason \"<why>\" --ticket <ticket-id>"
    echo ""
    echo "Options:"
    echo "  --reason TEXT    Mandatory justification (logged)"
    echo "  --ticket ID      Mandatory ticket/incident reference"
    echo "  --duration SECS  Override duration (max ${MAX_TTL_SECS}s, default ${MAX_TTL_SECS}s)"
    echo "  --rollback-only  Just restore the last known good rules (no audit mode)"
    echo "  --help           This help"
    exit 1
}

REASON=""
TICKET=""
DURATION="${MAX_TTL_SECS}"
ROLLBACK_ONLY=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --reason) REASON="$2"; shift 2 ;;
        --ticket) TICKET="$2"; shift 2 ;;
        --duration) DURATION="$2"; shift 2 ;;
        --rollback-only) ROLLBACK_ONLY=true; shift ;;
        --help|-h) usage ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

# --- Validations ---------------------------------------------------------

if [[ -z "$REASON" || -z "$TICKET" ]]; then
    echo "ERROR: --reason and --ticket are mandatory." >&2
    usage
fi

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: must run as root (sudo vigile-breakglass ...)" >&2
    exit 1
fi

if [[ "$DURATION" -gt "$MAX_TTL_SECS" ]]; then
    echo "ERROR: duration ${DURATION}s exceeds maximum ${MAX_TTL_SECS}s" >&2
    exit 1
fi

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
HOSTNAME=$(hostname)

# --- Log the action (audit trail) ----------------------------------------

log_entry() {
    echo "[${TIMESTAMP}] [${TICKET}] ${HOSTNAME}: $*" >> "$VIGILE_LOG"
    chmod 600 "$VIGILE_LOG"
}

log_entry "BREAK-GLASS ACTIVATED"
log_entry "  reason: ${REASON}"
log_entry "  ticket: ${TICKET}"
log_entry "  duration: ${DURATION}s"
log_entry "  mode: $([[ "$ROLLBACK_ONLY" == true ]] && echo "rollback-only" || echo "audit-mode")"

echo "╔══════════════════════════════════════════════════════╗"
echo "║           ⚠️  VIGILE BREAK-GLASS ACTIVÉ  ⚠️            ║"
echo "╠══════════════════════════════════════════════════════╣"
echo "║  Ticket : ${TICKET}"
echo "║  Raison : ${REASON}"
echo "║  Durée  : ${DURATION}s (max ${MAX_TTL_SECS}s)"
echo "║  Log    : ${VIGILE_LOG}"
echo "║  Le serveur sera alerté à la prochaine synchronisation. ║"
echo "╚══════════════════════════════════════════════════════╝"
echo ""

# --- Action ---------------------------------------------------------------

if [[ "$ROLLBACK_ONLY" == true ]]; then
    echo "[1/3] Restauration des dernières règles connues (LKG)..."
    if command -v fapolicyd-cli >/dev/null 2>&1; then
        # Remove Vigile's deployed rules (restore to pre-Vigile state).
        if [[ -d "$VIGILE_RULES_DIR" ]]; then
            rm -f "$VIGILE_RULES_DIR"/*.rules
            log_entry "  removed Vigile rules from ${VIGILE_RULES_DIR}"
        fi
        fapolicyd-cli --reload-rules 2>/dev/null || true
        log_entry "  fapolicyd rules reloaded"
    fi
else
    echo "[1/3] Basculement en mode audit (aucun blocage)..."
    if [[ -d "$VIGILE_RULES_DIR" ]]; then
        # Replace deny with deny_audit in all Vigile rules.
        for rules_file in "$VIGILE_RULES_DIR"/*.rules; do
            [[ -f "$rules_file" ]] || continue
            sed -i 's/^deny perm=/deny_audit perm=/' "$rules_file"
            log_entry "  converted $(basename "$rules_file") to audit mode"
        done
        if command -v fapolicyd-cli >/dev/null 2>&1; then
            fapolicyd-cli --reload-rules 2>/dev/null || true
            log_entry "  fapolicyd rules reloaded (audit mode)"
        fi
    fi
fi

echo "[2/3] Planification de la restauration automatique..."
# Schedule enforcement resumption via systemd timer or at(1).
RESUME_AT=$(date -d "+${DURATION} seconds" 2>/dev/null || date -v+"${DURATION}"S 2>/dev/null || echo "unknown")
log_entry "  enforcement will resume at: ${RESUME_AT}"

# Create a self-destructing script to restore enforcement.
RESUME_SCRIPT="/tmp/vigile-resume-$$"
cat > "$RESUME_SCRIPT" << 'RESUME_EOF'
#!/usr/bin/env bash
# Auto-generated by vigile-breakglass — restores enforcement.
set -euo pipefail
VIGILE_RULES_DIR="/etc/fapolicyd/rules.d/vigile"
for rules_file in "$VIGILE_RULES_DIR"/*.rules; do
    [[ -f "$rules_file" ]] || continue
    sed -i 's/^deny_audit perm=/deny perm=/' "$rules_file"
done
if command -v fapolicyd-cli >/dev/null 2>&1; then
    fapolicyd-cli --reload-rules 2>/dev/null || true
fi
rm -f "$0"
RESUME_EOF
chmod 700 "$RESUME_SCRIPT"
nohup bash -c "sleep ${DURATION}; ${RESUME_SCRIPT}" >/dev/null 2>&1 &
log_entry "  resume scheduled (PID $!)"

echo "[3/3] Terminé."
echo ""
echo "  L'enforcement reprendra automatiquement dans ${DURATION}s."
echo "  Pour le restaurer manuellement :"
echo "    sudo bash ${RESUME_SCRIPT}"
echo ""
echo "  ⚠️  Cette action est journalisée et sera signalée au serveur."
echo ""

log_entry "BREAK-GLASS COMPLETED"
