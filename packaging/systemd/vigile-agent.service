# vigile-agent.service — Vigile unprivileged agent (ISS-041)
#
# The agent is UNPRIVILEGED by design (ADR-0002). It handles network
# synchronization, certificate management, event collection and policy
# compilation — everything EXCEPT applying artifacts to the system.
# All privileged operations go through the executor via IPC.

[Unit]
Description=Vigile security agent (unprivileged)
Documentation=file:/usr/share/doc/vigile/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/vigile-agent --daemon

# --- Identity -----------------------------------------------------------
# Dedicated user, no shell, no login.
User=vigile
Group=vigile
DynamicUser=no
# Ensure the home directory exists but is not accessible to others.
StateDirectory=vigile
StateDirectoryMode=0750

# --- Filesystem protection -----------------------------------------------
# Strict: the ENTIRE filesystem is read-only except for explicit
# ReadWritePaths. The agent needs to write its state, spool and identity.
ProtectSystem=strict
ReadWritePaths=/var/lib/vigile
# /home and /root are inaccessible.
ProtectHome=yes
# Private /tmp and /dev/shm (not shared with other services).
PrivateTmp=yes
# /dev is minimal (no physical devices).
PrivateDevices=yes

# --- Privilege escalation prevention -------------------------------------
# Cannot gain new privileges via setuid/setgid/binaries.
NoNewPrivileges=yes
# Cannot create SUID/SGID files.
RestrictSUIDSGID=yes
# Cannot change ABI personality.
LockPersonality=yes

# --- Kernel protections ---------------------------------------------------
# /proc/sys, /proc/sysrq-trigger, /proc/kcore: read-only.
ProtectKernelTunables=yes
# Cannot load kernel modules.
ProtectKernelModules=yes
# Cannot read/write cgroup hierarchy.
ProtectControlGroups=yes
# /proc/kallsyms is masked (prevents kernel address leaks).
ProtectKernelLogs=yes
# Cannot use kexec.
ProtectClock=yes
# No IPC namespace sharing with other services (future: PrivateIPC=yes
# when systemd ≥ 254 is baseline).
PrivateIPC=no

# --- Network (REQUIRED for the agent) -------------------------------------
# The agent MUST connect to the Vigile server over HTTPS/mTLS.
# Restrict to the address families actually needed: IPv4, IPv6, Unix
# (for the IPC socket to the executor).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# --- Memory protections ----------------------------------------------------
# W^X: memory pages cannot be both writable and executable.
MemoryDenyWriteExecute=yes
# No realtime scheduling (prevent priority inversion attacks).
RestrictRealtime=yes

# --- Capabilities -----------------------------------------------------------
# The agent needs ZERO Linux capabilities. It runs as the unprivileged
# 'vigile' user and makes outgoing network connections (no CAP_NET_BIND
# needed since it uses ephemeral ports ≥ 1024).
CapabilityBoundingSet=

# --- Seccomp (system call filtering) ------------------------------------------
# Blacklist approach: deny dangerous syscall groups. The real barrier
# is the empty CapabilityBoundingSet + ProtectSystem=strict above.
# The agent needs network (HTTPS/mTLS), file I/O, and signals.
# Groups denied: @obsolete (compat), @mount, @debug (ptrace), @swap.
SystemCallFilter=~@obsolete @mount @debug @swap

# --- Resource limits ----------------------------------------------------------
# The agent should be lightweight (TEST_STRATEGY §F: < 1% CPU, < 100 MB RAM).
MemoryMax=150M
CPUQuota=10%
# Limit file descriptors (prevents fd exhaustion).
LimitNOFILE=4096
# Core dumps are disabled (prevent information leakage).
LimitCORE=0

# --- Misc -----------------------------------------------------------------------
# UMask for files created by the agent (no world access).
UMask=0077
# Standard output/error go to the journal.
StandardOutput=journal
StandardError=journal
# Syslog identifier for filtering.
SyslogIdentifier=vigile-agent

[Install]
WantedBy=multi-user.target
