# vigile-executor.service — Vigile privileged executor (ISS-041)
#
# The executor is the MINIMAL privileged component (ADR-0002). It applies
# policy artifacts (rules files, trust entries) via the IPC protocol from
# the agent. It has NO network access — it only listens on a Unix socket.
#
# SECURITY MODEL:
# - Root is needed to write to /etc/fapolicyd/ and reload the daemon.
# - The IPC socket is the ONLY entry point (no network).
# - The action catalog is CLOSED (8 actions, vigile-ipc).
# - Every action is journaled.

[Unit]
Description=Vigile privileged executor (minimal)
Documentation=file:/usr/share/doc/vigile/README.md
After=local-fs.target
# The executor must be running before the agent tries to apply policies.
Before=vigile-agent.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/vigile-executor --socket /run/vigile/executor.sock

# --- Identity -----------------------------------------------------------
# Root is required for writing to /etc/fapolicyd/ and sending signals
# to fapolicyd. This is the ONLY Vigile component that runs as root.
User=root
Group=root

# --- Filesystem protection -----------------------------------------------
# Strict: the entire filesystem is read-only EXCEPT the explicit paths
# below. These are the MINIMUM required for the executor to function:
# - /var/lib/vigile/executor: staging, active, LKG directories
# - /etc/fapolicyd: rule files and trust entries (the deployment target)
# - /run/vigile: IPC socket
ProtectSystem=strict
ReadWritePaths=/var/lib/vigile/executor
ReadWritePaths=/etc/fapolicyd
ReadWritePaths=/run/vigile
# /home and /root are completely inaccessible.
ProtectHome=yes
# Private /tmp (for any temporary operations during atomic renames).
PrivateTmp=yes
# No direct device access.
PrivateDevices=yes

# Ensure the runtime directory for the IPC socket exists.
RuntimeDirectory=vigile
RuntimeDirectoryMode=0750

# --- Privilege escalation prevention -------------------------------------
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# --- Kernel protections ---------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
PrivateIPC=no

# --- Network (DENIED for the executor) -------------------------------------
# The executor has ZERO network access. It communicates only via the
# Unix domain socket. This is a critical security property: even if the
# executor is compromised, it cannot phone home.
RestrictAddressFamilies=AF_UNIX

# --- Memory protections ----------------------------------------------------
MemoryDenyWriteExecute=yes
RestrictRealtime=yes

# --- Capabilities -----------------------------------------------------------
# AUDIT (see HARDENING.md for the full analysis):
# - CAP_DAC_OVERRIDE: needed to write files in /etc/fapolicyd/ that
#   may be owned by different users (e.g., fapolicyd).
# - CAP_FOWNER: needed to chown files to the correct owner after
#   writing (artifact specs carry an owner field).
# - CAP_KILL: needed to send SIGHUP to fapolicyd for rule reload.
#   (Alternatively: use systemctl reload — then not needed.)
# - CAP_SYS_CHROOT: NOT needed (we don't chroot).
# - CAP_NET_BIND_SERVICE: NOT needed (no network).
# - CAP_SYS_ADMIN: NOT needed (we don't mount, don't manage namespaces).
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER

# --- Seccomp (system call filtering) ------------------------------------------
# The executor's syscall surface is TINY: file I/O (open, write, rename,
# fsync, mkdir, chmod), directory operations, and IPC (socket, accept,
# read, write). No network syscalls, no memory mapping, no process
# creation. Using a blacklist approach for maximum compatibility while
# the real protection comes from RestrictAddressFamilies and
# CapabilityBoundingSet above.
SystemCallFilter=~@network-io @obsolete @mount @debug @swap
SystemCallArchitectures=native

# --- Resource limits ----------------------------------------------------------
MemoryMax=100M
CPUQuota=20%
LimitNOFILE=256
LimitCORE=0
TasksMax=16

# --- Misc -----------------------------------------------------------------------
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vigile-executor
# Short timeout — the executor should start fast.
TimeoutStartSec=10
# Restart on failure but with a delay (avoid tight loops).
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
