{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigile.invalid/schemas/policy-v0.schema.json",
  "title": "Vigile policy document (policy/v0)",
  "description": "Strict schema for Vigile policies. Unknown fields are rejected everywhere (SEC-208). Semantic rules (contradictions, bounded exceptions, protected-list merge) are enforced by the compiler, not by this schema — see docs/POLICY_MODEL.md sections 3.3 and 5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy"],
  "properties": {
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schema_version", "tenant", "target", "execution", "validity"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "schema_version": { "const": "policy/v0" },
        "tenant": { "$ref": "#/$defs/uuid" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["groups"],
          "properties": {
            "groups": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "application": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "package": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "vendor": { "type": "string", "enum": ["distribution", "upstream", "custom"] }
                  }
                },
                "hashes": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/sha256" }
                },
                "signer": { "type": ["string", "null"] }
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision"],
          "properties": {
            "decision": { "enum": ["allow", "deny", "audit-only", "not-applicable"] },
            "interpreters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allow": { "type": "array", "items": { "$ref": "#/$defs/absolutePath" } },
                "deny": { "type": "array", "items": { "$ref": "#/$defs/absolutePath" } }
              }
            }
          }
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "$ref": "#/$defs/allowDenyPaths" },
            "write": { "$ref": "#/$defs/allowDenyPaths" }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default"],
          "properties": {
            "default": { "enum": ["allow", "deny"] },
            "allow": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["protocol", "destination"],
                "properties": {
                  "protocol": { "enum": ["tcp", "udp", "sctp"] },
                  "destination": { "type": "string", "minLength": 1 },
                  "ports": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
                  }
                }
              }
            }
          }
        },
        "usb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision"],
          "properties": {
            "decision": { "enum": ["allow", "deny", "audit-only", "not-applicable"] }
          }
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_before"],
          "properties": {
            "not_before": { "type": "string", "format": "date-time" },
            "not_after": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required_roles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "references": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": { "enum": ["audit-only", "simulation", "canary", "rings", "percentage"] },
            "rings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protected_services": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-zA-Z0-9._@-]+\\.service$" }
            }
          }
        }
      }
    },
    "allowDenyPaths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "$ref": "#/$defs/pathExpr" } },
        "deny": { "type": "array", "items": { "$ref": "#/$defs/pathExpr" } }
      }
    },
    "pathExpr": {
      "description": "Canonical path expression: absolute path or $HOME-prefixed, with an optional '**' suffix glob. Rejects relative paths, '..', double slashes, control characters.",
      "type": "string",
      "pattern": "^(\\$HOME(/[a-zA-Z0-9._+@=-]+)+|/[a-zA-Z0-9._+@=-]+(?:/[a-zA-Z0-9._+@=-]+)*)(/\\*\\*)?$",
      "not": { "pattern": "\\.\\." }
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^(\\$HOME|[a-z]+)?(/[a-zA-Z0-9._+@=-]+)+$",
      "not": { "pattern": "\\.\\." }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
